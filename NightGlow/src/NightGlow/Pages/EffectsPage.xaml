<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NightGlow.Pages.EffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fx="using:NightGlow.Core.Lighting"
    xmlns:local="using:NightGlow.Pages"
    Background="Transparent">

    <Grid Padding="32,24,32,24" ColumnSpacing="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="灯效" Style="{StaticResource NgPageTitle}" />
            <TextBlock Text="硬件灯效由灯光控制器自己运行，关掉 NightGlow 也会保持；软件灯效需要 NightGlow 在后台运行。" Style="{StaticResource NgMuted}" />
        </StackPanel>

        <GridView x:Name="EffectGrid" Grid.Row="1" SelectionMode="Single" SelectionChanged="EffectGrid_SelectionChanged"
                  IsItemClickEnabled="False" Padding="0,0,0,24">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="fx:EffectDefinition">
                    <Grid Width="160" Height="124" CornerRadius="12" Background="{ThemeResource NgCardBrush}"
                          BorderBrush="{ThemeResource NgCardBorderBrush}" BorderThickness="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Fill="{x:Bind local:EffectVisuals.MakeBrush(PreviewColors)}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,1" CornerRadius="4"
                                Background="#99000000">
                            <TextBlock Text="{x:Bind KindText}" FontSize="11" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Row="1" Padding="12,8" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource NgMuted}" FontSize="12"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ScrollViewer Grid.Row="1" Grid.Column="1">
            <StackPanel Spacing="16" Padding="0,0,8,24">
                <Border Style="{StaticResource NgCard}" Padding="0">
                    <StackPanel>
                        <!-- live preview -->
                        <Grid Height="70" Padding="14" Background="#FF07080D" CornerRadius="12,12,0,0">
                            <StackPanel x:Name="PreviewStrip" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" />
                        </Grid>
                        <StackPanel Padding="20" Spacing="14">
                            <StackPanel>
                                <TextBlock x:Name="FxName" Text="选择一个灯效" Style="{StaticResource NgSectionTitle}" Margin="0" />
                                <TextBlock x:Name="FxDesc" Style="{StaticResource NgMuted}" />
                            </StackPanel>

                            <StackPanel x:Name="ColorRow" Orientation="Horizontal" Spacing="10">
                                <Button x:Name="Color1Button" Click="ColorButton_Click" Tag="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="Color1Swatch" Width="18" Height="18" CornerRadius="4" />
                                        <TextBlock Text="颜色 1" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="Color2Button" Click="ColorButton_Click" Tag="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border x:Name="Color2Swatch" Width="18" Height="18" CornerRadius="4" />
                                        <TextBlock Text="颜色 2" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <StackPanel x:Name="SpeedRow">
                                <TextBlock Text="速度" Style="{StaticResource NgMuted}" />
                                <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" StepFrequency="1" TickFrequency="1"
                                        TickPlacement="BottomRight" ValueChanged="Param_Changed" />
                            </StackPanel>
                            <StackPanel x:Name="DurationRow">
                                <TextBlock Text="时长（机身灯每段动作的长度）" Style="{StaticResource NgMuted}" />
                                <Slider x:Name="DurationSlider" Minimum="1" Maximum="10" StepFrequency="1" TickFrequency="1"
                                        TickPlacement="BottomRight" ValueChanged="Param_Changed" />
                            </StackPanel>
                            <ToggleSwitch x:Name="ReverseSwitch" Header="方向" OffContent="从第一个灯区流向最后一个"
                                          OnContent="从最后一个灯区流向第一个" Toggled="ReverseSwitch_Toggled" />
                            <StackPanel>
                                <TextBlock Text="亮度" Style="{StaticResource NgMuted}" />
                                <Slider x:Name="BrightSlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="Param_Changed" />
                            </StackPanel>

                            <StackPanel Spacing="6">
                                <TextBlock Text="应用到" Style="{StaticResource NgMuted}" />
                                <ItemsControl x:Name="TargetList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="local:TargetRow">
                                            <CheckBox IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind IsSupported, Mode=OneWay}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Bind Title}" />
                                                    <TextBlock Text="{x:Bind Note, Mode=OneWay}" Style="{StaticResource NgMuted}" FontSize="12" />
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="ApplyButton" Style="{StaticResource AccentButtonStyle}" Click="Apply_Click" MinWidth="120">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="应用" /></StackPanel>
                                </Button>
                                <Button x:Name="StopButton" Click="Stop_Click" ToolTipService.ToolTip="停止正在运行的软件灯效">
                                    <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock Text="停止软件灯效" /></StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="ApplyStatus" Style="{StaticResource NgMuted}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource NgCard}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="照明模式" Style="{StaticResource NgSectionTitle}" Margin="0" />
                        <TextBlock Text="一键调暗或关闭所有灯光，当前灯效保持不变；切回“正常”即恢复。" Style="{StaticResource NgMuted}"
                                   FontSize="12" TextWrapping="Wrap" />
                        <RadioButtons x:Name="ModeButtons" MaxColumns="3" SelectionChanged="ModeButtons_SelectionChanged">
                            <x:String>正常</x:String>
                            <x:String>调暗</x:String>
                            <x:String>关闭</x:String>
                        </RadioButtons>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
