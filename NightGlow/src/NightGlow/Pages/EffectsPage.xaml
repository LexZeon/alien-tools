<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NightGlow.Pages.EffectsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fx="using:NightGlow.Core.Lighting"
    xmlns:ctl="using:NightGlow.Controls"
    xmlns:local="using:NightGlow.Pages"
    Background="Transparent">

    <Grid Padding="32,24,32,16" ColumnSpacing="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2" Spacing="4">
            <TextBlock Text="灯效" Style="{StaticResource NgPageTitle}" />
            <TextBlock Text="选区域、点灯效，灯光马上跟着变。硬件灯效关掉 NightGlow 也会保持；软件和互动灯效需要 NightGlow 在后台运行。" Style="{StaticResource NgMuted}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- live canvas: click regions to select them, or click anywhere to drop a ripple -->
        <Border Grid.Row="1" CornerRadius="12" Background="#FF07080D" BorderBrush="{ThemeResource NgCardBorderBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <ctl:LaptopCanvas x:Name="LaptopView" Height="270" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="8,3" CornerRadius="6" Background="#AA000000" IsHitTestVisible="False">
                    <TextBlock x:Name="CanvasHint" FontSize="12" Foreground="#CCFFFFFF" Text="点击区域选中或取消" />
                </Border>
            </Grid>
        </Border>

        <GridView x:Name="EffectGrid" Grid.Row="2" SelectionMode="Single" SelectionChanged="EffectGrid_SelectionChanged"
                  IsItemClickEnabled="False" Padding="0,0,0,16">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="fx:EffectDefinition">
                    <Grid Width="160" Height="112" CornerRadius="12" Background="{ThemeResource NgCardBrush}"
                          BorderBrush="{ThemeResource NgCardBorderBrush}" BorderThickness="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Rectangle Fill="{x:Bind local:EffectVisuals.MakeBrush(PreviewColors)}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="6,1" CornerRadius="4"
                                Background="#99000000">
                            <TextBlock Text="{x:Bind KindText}" FontSize="11" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Row="1" Padding="12,6" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource NgMuted}" FontSize="12"
                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <ScrollViewer Grid.Row="1" Grid.RowSpan="2" Grid.Column="1">
            <StackPanel Spacing="16" Margin="0,0,8,16">
            <Border Style="{StaticResource NgCard}">
                <StackPanel Spacing="14">
                    <StackPanel>
                        <TextBlock x:Name="FxName" Text="选择一个灯效" Style="{StaticResource NgSectionTitle}" Margin="0" />
                        <TextBlock x:Name="FxDesc" Style="{StaticResource NgMuted}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="区域" Style="{StaticResource NgMuted}" />
                        <ItemsControl x:Name="RegionList" Height="140">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="134" ItemHeight="44" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:RegionChip">
                                    <ToggleButton IsChecked="{x:Bind IsChecked, Mode=TwoWay}" IsEnabled="{x:Bind IsAvailable, Mode=OneWay}"
                                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="0,0,6,6"
                                                  ToolTipService.ToolTip="{x:Bind Note, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" />
                                            <TextBlock Text="{x:Bind Name}" />
                                        </StackPanel>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="RegionNote" Style="{StaticResource NgMuted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="DirectionRow" Spacing="6">
                        <TextBlock Text="方向" Style="{StaticResource NgMuted}" />
                        <ComboBox x:Name="DirectionBox" HorizontalAlignment="Stretch" SelectionChanged="Option_Changed" />
                    </StackPanel>

                    <StackPanel x:Name="PaletteRow" Spacing="6">
                        <TextBlock Text="配色" Style="{StaticResource NgMuted}" />
                        <GridView x:Name="PaletteGrid" SelectionMode="Single" SelectionChanged="Option_Changed" Padding="0">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="fx:Palette">
                                    <StackPanel Width="62" Spacing="3" Padding="0,2">
                                        <Rectangle Height="18" RadiusX="9" RadiusY="9" Fill="{x:Bind local:EffectVisuals.MakeBrush(PreviewHex)}" />
                                        <TextBlock Text="{x:Bind Name}" FontSize="12" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>

                    <StackPanel x:Name="ColorRow" Orientation="Horizontal" Spacing="10">
                        <Button x:Name="Color1Button" Click="ColorButton_Click" Tag="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="Color1Swatch" Width="18" Height="18" CornerRadius="4" />
                                <TextBlock Text="颜色 1" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="Color2Button" Click="ColorButton_Click" Tag="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="Color2Swatch" Width="18" Height="18" CornerRadius="4" />
                                <TextBlock Text="颜色 2" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="RainRow" Spacing="2">
                        <ToggleSwitch x:Name="RainSwitch" Header="自动下雨" OnContent="开" OffContent="关" Toggled="Rain_Toggled" />
                        <TextBlock Text="在上方预览图里点击任意位置，就会从那里荡开一圈波纹；运行时灯光同步。" Style="{StaticResource NgMuted}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="SpeedRow">
                        <TextBlock Text="速度" Style="{StaticResource NgMuted}" />
                        <Slider x:Name="SpeedSlider" Minimum="1" Maximum="10" StepFrequency="1" TickFrequency="1"
                                TickPlacement="BottomRight" ValueChanged="Param_Changed" />
                    </StackPanel>
                    <StackPanel x:Name="DurationRow">
                        <TextBlock Text="时长（机身灯每段动作的长度）" Style="{StaticResource NgMuted}" />
                        <Slider x:Name="DurationSlider" Minimum="1" Maximum="10" StepFrequency="1" TickFrequency="1"
                                TickPlacement="BottomRight" ValueChanged="Param_Changed" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="亮度" Style="{StaticResource NgMuted}" />
                        <Slider x:Name="BrightSlider" Minimum="10" Maximum="100" StepFrequency="5" ValueChanged="Param_Changed" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="ApplyButton" Click="Apply_Click" ToolTipService.ToolTip="改动会自动应用；灯光和预览不一致时点这里再发送一次">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72C;" FontSize="14" /><TextBlock Text="重新应用" /></StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Click="Stop_Click" ToolTipService.ToolTip="停止正在运行的软件灯效">
                            <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE71A;" FontSize="14" /><TextBlock Text="停止软件灯效" /></StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="ApplyStatus" Style="{StaticResource NgMuted}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource NgCard}">
                <StackPanel Spacing="8">
                    <TextBlock Text="照明模式" Style="{StaticResource NgSectionTitle}" Margin="0" />
                    <TextBlock Text="一键调暗或关闭所有灯光，当前灯效保持不变；切回“正常”即恢复。" Style="{StaticResource NgMuted}"
                               FontSize="12" TextWrapping="Wrap" />
                    <RadioButtons x:Name="ModeButtons" MaxColumns="3" SelectionChanged="ModeButtons_SelectionChanged">
                        <x:String>正常</x:String>
                        <x:String>调暗</x:String>
                        <x:String>关闭</x:String>
                    </RadioButtons>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
