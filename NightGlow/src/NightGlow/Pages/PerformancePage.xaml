<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="NightGlow.Pages.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:NightGlow.Core"
    Background="Transparent">

    <ScrollViewer>
        <StackPanel Padding="36,24,36,36" Spacing="18" MaxWidth="1200" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="性能与散热" Style="{StaticResource NgPageTitle}" />
                <TextBlock Text="只提供 BIOS 自带的厂商预设模式，不做手动风扇曲线、超频或降压。" Style="{StaticResource NgMuted}" />
            </StackPanel>

            <InfoBar x:Name="AdminInfo" Severity="Warning" IsClosable="False" Title="需要管理员权限"
                     Message="读取温度和风扇转速、切换性能模式都要通过 BIOS 接口，Windows 只允许管理员调用。灯光功能不受影响。">
                <InfoBar.ActionButton>
                    <Button Content="以管理员身份重启 NightGlow" Click="RelaunchAdmin_Click" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar x:Name="StatusInfo" Severity="Informational" IsClosable="False" />
            <InfoBar x:Name="VendorInfo" Severity="Informational" IsClosable="True" Title="厂商控制中心正在运行"
                     Message="它也会切换散热模式（比如按游戏自动切换），可能覆盖这里的选择。" />

            <TextBlock Text="性能模式" Style="{StaticResource NgSectionTitle}" />
            <GridView x:Name="ModeGrid" SelectionMode="Single" SelectionChanged="ModeGrid_SelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="core:PowerModeInfo">
                        <Grid Width="190" Height="104" Padding="16,14" CornerRadius="12"
                              Background="{ThemeResource NgCardBrush}" BorderBrush="{ThemeResource NgCardBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="6">
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" HorizontalAlignment="Left" Foreground="{StaticResource NgAccentBrush}" />
                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource NgMuted}" FontSize="12" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
            <TextBlock x:Name="ModeStatus" Style="{StaticResource NgMuted}" FontSize="12" />

            <TextBlock Text="温度" Style="{StaticResource NgSectionTitle}" Margin="0,8,0,0" />
            <ItemsControl x:Name="SensorList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:SensorReading">
                        <Border Style="{StaticResource NgCard}" Width="170">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource NgMuted}" />
                                <TextBlock Style="{StaticResource NgBigNumber}">
                                    <Run Text="{x:Bind Celsius}" /><Run Text=" °C" FontSize="18" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="风扇" Style="{StaticResource NgSectionTitle}" Margin="0,8,0,0" />
            <ItemsControl x:Name="FanList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="core:FanReading">
                        <Border Style="{StaticResource NgCard}" Width="200">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent}" Maximum="100" Width="52" Height="52" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" Style="{StaticResource NgMuted}" />
                                    <TextBlock FontSize="22" FontWeight="SemiBold">
                                        <Run Text="{x:Bind Rpm}" /><Run Text=" RPM" FontSize="13" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource NgMuted}" FontSize="12">
                                        <Run Text="最高 " /><Run Text="{x:Bind MaxRpm}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="NoReadings" Text="暂无读数。" Style="{StaticResource NgMuted}" />
        </StackPanel>
    </ScrollViewer>
</Page>
