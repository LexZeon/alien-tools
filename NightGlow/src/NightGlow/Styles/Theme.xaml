<?xml version="1.0" encoding="utf-8"?>
<!-- NightGlow visual language: deep night background, a single cyan-violet glow accent. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="NgAccent">#FF35D6E8</Color>
            <Color x:Key="NgAccent2">#FF8B5CF6</Color>
            <Color x:Key="NgCardColor">#14FFFFFF</Color>
            <Color x:Key="NgCardBorderColor">#22FFFFFF</Color>
            <Color x:Key="NgMutedText">#B3FFFFFF</Color>
            <Color x:Key="NgWarnColor">#FFFFB547</Color>
            <Color x:Key="NgBadColor">#FFFF6B6B</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="NgAccent">#FF0E8FA3</Color>
            <Color x:Key="NgAccent2">#FF6D3FE0</Color>
            <Color x:Key="NgCardColor">#B3FFFFFF</Color>
            <Color x:Key="NgCardBorderColor">#1A000000</Color>
            <Color x:Key="NgMutedText">#99000000</Color>
            <Color x:Key="NgWarnColor">#FFB86E00</Color>
            <Color x:Key="NgBadColor">#FFC62828</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="NgAccentBrush" Color="{ThemeResource NgAccent}" />
    <SolidColorBrush x:Key="NgCardBrush" Color="{ThemeResource NgCardColor}" />
    <SolidColorBrush x:Key="NgCardBorderBrush" Color="{ThemeResource NgCardBorderColor}" />
    <SolidColorBrush x:Key="NgMutedBrush" Color="{ThemeResource NgMutedText}" />
    <SolidColorBrush x:Key="NgWarnBrush" Color="{ThemeResource NgWarnColor}" />
    <SolidColorBrush x:Key="NgBadBrush" Color="{ThemeResource NgBadColor}" />

    <LinearGradientBrush x:Key="NgGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource NgAccent}" Offset="0" />
        <GradientStop Color="{ThemeResource NgAccent2}" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="NgCard" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource NgCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource NgCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="NgPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="NgSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="NgMuted" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource NgMutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NgBigNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    </Style>
</ResourceDictionary>
